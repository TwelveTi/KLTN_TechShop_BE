NODE_ENV=development
PORT=3000
HOST_NAME=localhost

FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=techshop
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_me_access_token_secret
JWT_REFRESH_SECRET=change_me_refresh_token_secret

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Backend public base URL (used to build the email verification link)
APP_URL=http://localhost:3000

# Kafka
KAFKA_ENABLED=true
KAFKA_CLIENT_ID=techshop-backend
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=techshop-email-consumer
KAFKA_TOPIC_EMAIL=techshop.email

# SMTP / email
# Default = Mailpit container (docker-compose.yml). Mail is CAUGHT locally at
# http://localhost:8025 and is NOT delivered to real inboxes.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TechShop <no-reply@techshop.local>

# To send REAL email via Gmail instead of Mailpit, comment out the block above
# and use these (create an App Password: Google Account > Security > App passwords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_16_char_app_password
# MAIL_FROM=TechShop <your_gmail@gmail.com>

# Email verification token (falls back to JWT_SECRET if empty)
EMAIL_TOKEN_SECRET=change_me_email_token_secret
EMAIL_TOKEN_EXPIRES_IN=24h

# Password reset OTP
OTP_EXPIRATION_MINUTES=10
MAX_OTP_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_TOKEN_EXPIRATION_MINUTES=10
# Secret used to HMAC the OTP before storing (falls back to JWT_SECRET if empty)
OTP_HASH_SECRET=change_me_otp_hash_secret

# Google OAuth2 (Google Cloud Console > APIs & Services > Credentials)
# Leave empty to disable "Login with Google". Authorized redirect URI in the
# Google console must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Payment - VNPay (https://sandbox.vnpayment.vn)
# Leave TmnCode/HashSecret empty to disable the VNPay flow.
vnp_TmnCode=
vnp_HashSecret=
vnp_Url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Optional - the config derives these from APP_URL / FRONTEND_URL when unset.
# vnp_Api=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# vnp_ReturnUrl=http://localhost:3000/api/v1/payments/vnpay/return
# vnp_IpnUrl=http://localhost:3000/api/v1/payments/vnpay/ipn
# vnp_ExpireMinutes=15
