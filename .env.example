NODE_ENV=development
PORT=3000
HOST_NAME=localhost

FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=techshop
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_me_access_token_secret
JWT_REFRESH_SECRET=change_me_refresh_token_secret

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Limiter chung cho MỌI route (duyệt sản phẩm, giỏ hàng, ảnh...). Các endpoint
# `/auth/*` có hạn mức riêng hẹp hơn nhiều, khai trong `routes/authRoute.js`.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Số CHẶNG reverse proxy đứng trước app. Localhost không có proxy nào nên để
# trống; sau Nginx/Railway/Render thường là 1.
#
# BẮT BUỘC đặt trước khi deploy: không có nó thì `req.ip` là địa chỉ của proxy,
# nên cả site dùng chung một xô rate limit — một kẻ tấn công tiêu hết hạn mức là
# mọi người cùng nhận 429, và rate limit theo IP không còn phân biệt được ai.
#
# ĐỪNG đặt `true`: nó tin mọi header `X-Forwarded-For` do client gửi lên, và khi
# đó mỗi request tự khai một "IP" mới nên không xô nào đầy được nữa. App sẽ cảnh
# báo ở log lúc boot nếu gặp `true`, hoặc nếu biến này trống ở production.
#
# Nhận: số chặng (1, 2...), `false`, hoặc danh sách IP/CIDR/tên dải của Express
# (`loopback`, `linklocal`, `uniquelocal`) ngăn cách bằng dấu phẩy.
TRUST_PROXY=

# Backend public base URL (used to build the email verification link)
APP_URL=http://localhost:3000

# Kafka
KAFKA_ENABLED=true
KAFKA_CLIENT_ID=techshop-backend
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=techshop-email-consumer
KAFKA_TOPIC_EMAIL=techshop.email

# SMTP / email
# Default = Mailpit container (docker-compose.yml). Mail is CAUGHT locally at
# http://localhost:8025 and is NOT delivered to real inboxes.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TechShop <no-reply@techshop.local>

# To send REAL email via Gmail instead of Mailpit, comment out the block above
# and use these (create an App Password: Google Account > Security > App passwords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_16_char_app_password
# MAIL_FROM=TechShop <your_gmail@gmail.com>

# Email verification token. Vẫn rơi về JWT_SECRET nếu bỏ trống, và điều đó an toàn
# nhờ trường `purpose` trong token (utils/jwt.js) chứ không nhờ việc tách khoá —
# nhưng nên đặt một khoá riêng.
EMAIL_TOKEN_SECRET=thay_bang_mot_khoa_32_byte_khac_nua
EMAIL_TOKEN_EXPIRES_IN=24h

# Password reset OTP
OTP_EXPIRATION_MINUTES=10
MAX_OTP_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_TOKEN_EXPIRATION_MINUTES=10
# Secret used to HMAC the OTP before storing (falls back to JWT_SECRET if empty)
OTP_HASH_SECRET=change_me_otp_hash_secret

# Google OAuth2 (Google Cloud Console > APIs & Services > Credentials)
# Leave empty to disable "Login with Google". Authorized redirect URI in the
# Google console must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Payment - VNPay (https://sandbox.vnpayment.vn)
# Leave TmnCode/HashSecret empty to disable the VNPay flow.
vnp_TmnCode=
vnp_HashSecret=
vnp_Url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Optional - the config derives these from APP_URL / FRONTEND_URL when unset.
# vnp_Api=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# vnp_ReturnUrl=http://localhost:3000/api/v1/payments/vnpay/return
# vnp_IpnUrl=http://localhost:3000/api/v1/payments/vnpay/ipn
# vnp_ExpireMinutes=15

# AI Product Advisor - Google Gemini (https://aistudio.google.com/apikey)
# Leave GEMINI_API_KEY empty to disable the advisor: the app still boots and
# every other route works, POST /api/v1/ai/advisor answers 503.
GEMINI_API_KEY=
# Optional - defaults shown. Pinned deliberately: gemini-flash-latest also works
# but moves under you, and measured thesis results need a fixed model.
# Alternatives available to this key: gemini-3.7-flash, gemini-3.8-flash,
# gemini-3.5-flash-lite (rẻ hơn). Note gemini-2.5-* is closed to new keys.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TEMPERATURE=0.2
# Gemini 3 spends thinking tokens out of this same budget. Below ~2048 the model
# can think its way through a tool result and have nothing left to answer with.
# GEMINI_MAX_OUTPUT_TOKENS=4096
# MINIMAL | LOW | MEDIUM | HIGH - explaining a filtered list is not a reasoning
# task, and HIGH buys latency and output tokens rather than a better answer.
# GEMINI_THINKING_LEVEL=LOW
# GEMINI_MAX_TOOL_TURNS=3
# Model dự phòng khi model chính hết hạn mức (429) hoặc không tồn tại (404).
# Hạn mức Gemini tính RIÊNG từng model, nên ba model là 60 request/ngày ở free
# tier thay vì 20. Để TRỐNG để tắt fallback — cần thiết khi đo đạc, vì lúc đó
# phải chắc mọi câu chạy trên đúng một model.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.8-flash
