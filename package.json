    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "js-yaml": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
